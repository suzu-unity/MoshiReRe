# Set this in your shell, CI secret store, or a local environment manager.
# Never commit a real key and never paste it into chat.
XAI_API_KEY=
XAI_MODEL=grok-4.5
XAI_BASE_URL=https://api.x.ai/v1
XAI_IMAGE_MODEL=grok-imagine-image-quality
XAI_VIDEO_MODEL=grok-imagine-video
# Optional: low, medium, or high
XAI_REASONING_EFFORT=high
# Optional positive integer values
# XAI_TIMEOUT_SECONDS=120
# XAI_VIDEO_TIMEOUT_SECONDS=900
# XAI_MAX_OUTPUT_TOKENS=8192
# Optional upload/request limits in bytes. Restart the server after changing.
# GROK_MAX_FILE_BYTES=26214400
# GROK_MAX_TOTAL_FILE_BYTES=52428800
# GROK_MAX_REQUEST_BYTES=67108864
