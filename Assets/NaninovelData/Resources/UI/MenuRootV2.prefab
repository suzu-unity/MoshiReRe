  locations:
  - baseName: STATION
    description: A bright gateway to the city.
    rereHint: The trains are calm right now.
    safety: 0.86
    relatedItemName: City Pass
    relatedCharacterName: ReRe / Yui / OJI
    dayColor: {r: 0.45, g: 0.78, b: 0.92, a: 1}
    nightColor: {r: 0.38, g: 0.48, b: 0.86, a: 1}
  - baseName: LIBRARY
    description: A quiet place full of useful clues.
    rereHint: Check the return desk for a new note.
    safety: 0.94
    relatedItemName: Library Card
    relatedCharacterName: Yui / Librarian
    dayColor: {r: 0.67, g: 0.58, b: 0.91, a: 1}
    nightColor: {r: 0.52, g: 0.43, b: 0.78, a: 1}
  - baseName: OFFICE
    description: Busy towers where OJI gather.
    rereHint: Lunch time is the safest window.
    safety: 0.68
    relatedItemName: Office Key
    relatedCharacterName: OJI / ReRe
    dayColor: {r: 0.62, g: 0.82, b: 0.94, a: 1}
    nightColor: {r: 0.34, g: 0.48, b: 0.74, a: 1}
  - baseName: ENTERTAINMENT
    description: Neon fun and unexpected meetings.
    rereHint: Bring something small for the arcade.
    safety: 0.56
    relatedItemName: Arcade Coin
    relatedCharacterName: Mina / ReRe
    dayColor: {r: 0.96, g: 0.45, b: 0.49, a: 1}
    nightColor: {r: 0.88, g: 0.34, b: 0.76, a: 1}
