    dayColor: {r: 0.96, g: 0.45, b: 0.49, a: 1}
    nightColor: {r: 0.88, g: 0.34, b: 0.76, a: 1}
  - baseName: "\u4E2D\u592E\u516C\u5712"
    description: "\u4EBA\u76EE\u3092\u907F\u3051\u3066\u8A71\u305B\u308B\u5834\u6240\u304C\u591A\u3044\u3001\u8857\u306E\u4E2D\u592E\u306B\u3042\u308B\u516C\u5712\u3002"
