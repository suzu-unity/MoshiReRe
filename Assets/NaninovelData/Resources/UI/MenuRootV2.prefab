  m_Name: 
  m_EditorClassIdentifier: MenuSystem::MapMenuController
  locations:
  - baseName: "\u99C5\u524D"
    description: "\u5F85\u3061\u5408\u308F\u305B\u3068\u79FB\u52D5\u306E\u8D77\u70B9\u3002\u5915\u65B9\u306F\u5E30\u5B85\u5BA2\u3067\u6DF7\u307F\u5408\u3046\u3002"
    rereHint: "\u4E57\u308A\u63DB\u3048\u524D\u306A\u3089\u3001\u5C11\u3057\u3060\u3051\u8A71\u3092\u805E\u3051\u305D\u3046\u3002"
    safety: 0.86
    relatedItemName: "\u4EA4\u901AIC\u30AB\u30FC\u30C9"
    relatedCharacterName: "ReRe / \u5BFE\u8C61A"
    dayColor: {r: 0.45, g: 0.78, b: 0.92, a: 1}
    nightColor: {r: 0.38, g: 0.48, b: 0.86, a: 1}
  - baseName: "\u5E02\u7ACB\u56F3\u66F8\u9928"
    description: "\u65B0\u805E\u30FB\u696D\u754C\u8A8C\u30FB\u904E\u53BB\u8CC7\u6599\u3092\u9759\u304B\u306B\u8ABF\u3079\u3089\u308C\u308B\u516C\u5171\u65BD\u8A2D\u3002"
    rereHint: "\u904E\u53BB\u306E\u8A18\u4E8B\u3092\u8ABF\u3079\u308B\u306A\u3089\u3001\u3053\u3053\u304C\u3044\u3061\u3070\u3093\u78BA\u5B9F\u3002"
    safety: 0.94
    relatedItemName: "\u56F3\u66F8\u9928\u5229\u7528\u8A3C"
    relatedCharacterName: "\u60C5\u5831\u5C4BB / \u53F8\u66F8"
    dayColor: {r: 0.67, g: 0.58, b: 0.91, a: 1}
    nightColor: {r: 0.52, g: 0.43, b: 0.78, a: 1}
  - baseName: "\u30AA\u30D5\u30A3\u30B9\u8857"
    description: "\u663C\u306F\u4F1A\u793E\u30D1\u30FC\u30C8\u306E\u4E2D\u5FC3\u3002\u9000\u52E4\u524D\u5F8C\u306B\u306F\u5BFE\u8C61\u3068\u63A5\u89E6\u3057\u3084\u3059\u3044\u3002"
    rereHint: "\u663C\u4F11\u307F\u304B\u9000\u52E4\u76F4\u5F8C\u3092\u72D9\u3046\u306E\u304C\u5B89\u5168\u305D\u3046\u3002"
    safety: 0.68
    relatedItemName: "\u793E\u54E1\u8A3C"
    relatedCharacterName: "\u53D6\u5F15\u5148\u306E\u5143\u62C5\u5F53 / ReRe"
    dayColor: {r: 0.62, g: 0.82, b: 0.94, a: 1}
    nightColor: {r: 0.34, g: 0.48, b: 0.74, a: 1}
  - baseName: "\u7E41\u83EF\u8857"
    description: "\u98F2\u98DF\u5E97\u3084\u904A\u6280\u65BD\u8A2D\u304C\u96C6\u307E\u308B\u591C\u306E\u60C5\u5831\u4EA4\u63DB\u30A8\u30EA\u30A2\u3002"
    rereHint: "\u591C\u306F\u51FA\u4F1A\u3044\u304C\u5897\u3048\u308B\u3051\u3069\u3001\u51FA\u8CBB\u306B\u3082\u6CE8\u610F\u3057\u3066\u306D\u3002"
    safety: 0.56
    relatedItemName: "\u30B2\u30FC\u30E0\u30B3\u30A4\u30F3"
    relatedCharacterName: "\u540C\u696D\u8005A / ReRe"
    dayColor: {r: 0.96, g: 0.45, b: 0.49, a: 1}
    nightColor: {r: 0.88, g: 0.34, b: 0.76, a: 1}
  - baseName: "\u4E2D\u592E\u516C\u5712"
    description: "\u4EBA\u76EE\u3092\u907F\u3051\u3066\u8A71\u305B\u308B\u5834\u6240\u304C\u591A\u3044\u3001\u8857\u306E\u4E2D\u592E\u306B\u3042\u308B\u516C\u5712\u3002"
    rereHint: "\u5674\u6C34\u306E\u8FD1\u304F\u306A\u3089\u3001\u843D\u3061\u7740\u3044\u3066\u8A71\u305B\u308B\u304B\u3082\u3002"
    safety: 0.91
