    nightColor: {r: 0.34, g: 0.48, b: 0.74, a: 1}
  - baseName: "\u30AB\u30D5\u30A7\u4E0B\u8ABF\u3079"
    description: "\u521D\u56DE\u30BF\u30FC\u30B2\u30C3\u30C8\u304C\u5F85\u3064\u30AB\u30D5\u30A7\u3002\u5E97\u5185\u3092\u4E0B\u8ABF\u3079\u3057\u3066\u304B\u3089
