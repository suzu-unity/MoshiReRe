    nightColor: {r: 0.34, g: 0.48, b: 0.74, a: 1}
  - baseName: "\u7E41\u83EF\u8857"
    description: "\u98F2\u98DF\u5E97\u3084\u904A\u6280\u65BD\u8A2D\u304C\u96C6\u307E\u308B\u591C\u306E\u60C5\u5831\u4EA4\u63DB\u30A8\u30EA\u30A2\u3002"
    rereHint: "\u591C\u306F\u51FA\u4F1A\u3044\u304C\u5897\u3048\u308B\u3051\u3069\u3001\u51FA\u8CBB\u306B\u3082\u6CE8\u610F\u3057\u3066\u306D\u3002"
